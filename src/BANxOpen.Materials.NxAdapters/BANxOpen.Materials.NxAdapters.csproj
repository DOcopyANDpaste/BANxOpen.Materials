<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The NX side of the material engine: the IPartMaterialService implementation, the physical/display material
    helpers it drives, and MaterialEngine, which wires the rules to them.

    In BANxOpen.Materials.sln so it loads in the IDE, but with an ActiveCfg entry and NO Build.0 entry in any
    configuration: it references real NXOpen assemblies that only resolve on a machine with NX installed. That
    keeps `dotnet build`/`dotnet test` on the .sln working everywhere else. Build it explicitly on an NX machine:
    `dotnet build src\BANxOpen.Materials.NxAdapters\BANxOpen.Materials.NxAdapters.csproj`.
  -->
  <Target Name="RequireUgiiBaseDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(UGII_BASE_DIR)' == ''"
           Text="UGII_BASE_DIR is not set. This project references the NXOpen managed assemblies and can only be built on a machine with NX installed." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.Contracts\BANxOpen.Foundation.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.Core\BANxOpen.Foundation.Core.csproj" />
    <ProjectReference Include="..\..\..\BANxOpen.Foundation\src\BANxOpen.Foundation.NxAdapters\BANxOpen.Foundation.NxAdapters.csproj" />
    <ProjectReference Include="..\BANxOpen.Materials.Contracts\BANxOpen.Materials.Contracts.csproj" />
    <ProjectReference Include="..\BANxOpen.Materials.Core\BANxOpen.Materials.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <NxManagedDir>$(UGII_BASE_DIR)\NXBIN\managed</NxManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="NXOpen">
      <HintPath>$(NxManagedDir)\NXOpen.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NXOpen.UF">
      <HintPath>$(NxManagedDir)\NXOpen.UF.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NXOpen.Utilities">
      <HintPath>$(NxManagedDir)\NXOpen.Utilities.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="NXOpenUI">
      <HintPath>$(NxManagedDir)\NXOpenUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
